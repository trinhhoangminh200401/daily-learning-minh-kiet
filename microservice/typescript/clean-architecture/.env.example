# ========================================
# ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and fill in actual values
# ========================================

# ========================================
# APPLICATION
# ========================================
NODE_ENV=development
APP_NAME=microservice-product-management
APP_VERSION=1.0.0
PORT=3000

# ========================================
# DATABASE - POSTGRESQL
# ========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<replace_with_secure_password>
POSTGRES_DB=products_db
POSTGRES_URL=postgresql://<user>:<password>@<host>:<port>/<database>

# ========================================
# DATABASE - MONGODB
# ========================================
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USER=admin
MONGODB_PASSWORD=<replace_with_secure_password>
MONGODB_DB=users_db
MONGODB_URL=mongodb://<user>:<password>@<host>:<port>/<database>?authSource=admin

# ========================================
# REDIS (CACHING/SESSION)
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<replace_with_redis_password>
REDIS_URL=redis://:<password>@<host>:<port>

# ========================================
# JWT AUTHENTICATION
# Generate secret: openssl rand -base64 64
# ========================================
JWT_SECRET=<replace_with_generated_secret>
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# ========================================
# BCRYPT
# ========================================
BCRYPT_SALT_ROUNDS=12

# ========================================
# DATABASE TYPE SELECTION
# Options: in-memory | postgres | mongodb
# ========================================
DATABASE_TYPE=in-memory
